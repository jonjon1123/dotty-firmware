+void Application::SetPrivacyGate(bool on) {
+    // Dotty privacy gate. Toggled by stackchan StateManager on enter/exit
+    // of SLEEP. When on:
+    //   - wake-word detection + voice processing forced off
+    //   - HandleStateChangedEvent stops re-arming them on subsequent
+    //     transitions through Idle / Listening (see the gate checks in
+    //     the kDeviceStateIdle and kDeviceStateListening cases)
+    //   - device state forced to Idle so any in-flight LISTENING/SPEAKING
+    //     is unwound through the normal state-change plumbing Γò¼├┤Γö£├ºΓö£Γòó display
+    //     status flips to STANDBY, which clears the listening LED via
+    //     stackchan_display::set_listening_pixel.
+    // When off: gate clears, and the next Idle transition re-arms wake-word
+    // through the normal kDeviceStateIdle path.
+    if (privacy_gate_ == on) return;
+    privacy_gate_ = on;
+    ESP_LOGI(TAG, "Privacy gate %s", on ? "engaged" : "lifted");
+    Schedule([this, on]() {
+        if (on) {
+            audio_service_.EnableVoiceProcessing(false);
+            audio_service_.EnableWakeWordDetection(false);
+            // Force out of any in-flight LISTENING/SPEAKING. If already
+            // Idle this is a no-op via state_machine_.TransitionTo's
+            // identity check.
+            SetDeviceState(kDeviceStateIdle);
+        } else {
+            // Re-arm only if we're idle Γò¼├┤Γö£├ºΓö£Γòó other states have their own
+            // entry-side audio setup, which the gate will no longer
+            // intercept.
+            if (state_machine_.GetState() == kDeviceStateIdle) {
+                audio_service_.EnableWakeWordDetection(true);
+            }
+        }
+    });
+}
